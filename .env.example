# Copy to .env and fill in the shared Supabase database password.
# .env is gitignored - never commit the real password.
#
# Run with `./gradlew bootRun` - it reads .env automatically.
# Do NOT use IntelliJ's green play button on the main class; it ignores .env.
#
# This is the session pooler (IPv4). Supabase's direct host,
# db.qjivggbmmfdxqyhcwzvu.supabase.co, is IPv6-only and unreachable from most
# Indian ISPs. Note the username carries the .<project-ref> suffix on the
# pooler - the direct host uses plain `postgres` instead.

DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.qjivggbmmfdxqyhcwzvu
DB_PASSWORD=
